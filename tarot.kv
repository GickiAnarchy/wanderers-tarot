<RootController>:
    screen_manager: screen_manager
    toolbar:toolbar
    nav_drawer: nav_drawer    
    orientation: "vertical"

    MDTopAppBar:
        id: toolbar
        title: "Digital Oracle"
        left_action_items: [["menu", lambda x: nav_drawer.set_state("open")]]
        elevation: 4

    MDNavigationLayout:

        MDScreenManager:
            id: screen_manager

        MDNavigationDrawer:
            id: nav_drawer

            MDNavigationDrawerMenu:

                MDNavigationDrawerLabel:
                    text: "Navigation"

                MDNavigationDrawerItem:
                    text: "Home"
                    icon: "home"
                    on_release: root.goto("home")
                    text_color: 0.2,0.1,0.6,1

                MDNavigationDrawerItem:
                    text: "Tarot Reading"
                    icon: "cards"
                    on_release: root.goto("tarot")
                    text_color: 0.2,0.1,0.6,1

                MDNavigationDrawerItem:
                    text: "Settings"
                    icon: "cog"
                    on_release: root.goto("settings")
                    text_color: 0.2,0.1,0.6,1


<HomeScreen>:
    name: "home"
    
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(15)
        spacing: dp(15)

        MDLabel:
            text: "Welcome to the Digital Oracle!"
            pos_hint: {"center_x": 0.5}
            font_style: "H4"
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]

        MDLabel:
            id: warning_label
            pos_hint: {"center_x": 0.8}
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]
            text_color: 1,0,0,1
        
        Widget:
            size_hint_y: None
            height: dp(200)


<SettingsScreen>:
    name: "settings"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        Widget:
            size_hint_y: None
            height: dp(20)

        MDBoxLayout:
            orientation: "vertical"
            padding: dp(10)
            size_hint_y: 0.3

            MDLabel:
                text: "Google AI API Key"
                font_style: "H6"
                size_hint_y: None
                height: self.texture_size[1]

            MDTextField:
                id: api_key_input
                hint_text: "Enter your Google AI API Key"
                text: root.api_key or ""

            MDBoxLayout:
                orientation: "horizontal"
                padding: dp(10)
                spacing: dp(10)
                size_hint_y: None
                height: dp(50)
                pos_hint: {"center_x": 0.5}

                MDRaisedButton:
                    text: "Reset API Key"
                    on_release: root.reset_api_key()

                MDRaisedButton:
                    text: "Save API Key"
                    on_release: root.save_api_key(api_key_input.text)
        
        Widget:


<TarotScreen>:
    in_field: in_field

    name: "tarot"

    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(10)
        padding: dp(10)
        pos_hint:{"center_x":0.5}

        MDLabel:
            text: "What do you seek?"
            font_syle: "H4"
            halign: "center"
            size_hint_y: None
            height: self.texture_size[1]

        MDTextField:
            id: in_field
            hint_text: "Ask the stars anything..."
            size_hint: 0.7,None
            height: dp(150)
            pos_hint: {"center_x":0.5,"center_y":0.5}
            multiline: True
        
        Widget:

        MDRaisedButton:
            text: "Ask..."
            size_hint: 0.3, None
            height: dp(30)
            on_release: root.ask_pressed()


<ReadingScreen>:
    res_label:res_label

    name: "reading"

    MDBoxLayout:
        orientation: "vertical"

        MDLabel:
            id: res_label
            size_hint: 0.8, 0.7
        
        MDRaisedButton:
            text:"Ok"
            size_hint: 0.3, None
            height: dp(30)
            on_release: root.ok_pressed()