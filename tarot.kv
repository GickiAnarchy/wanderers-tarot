<InputScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.08, 0.15, 1  # Midnight Blue
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 40
        spacing: 20
      
        Image:
            source: "data/logo.png"
            size_hint: None, None
            size: dp(220), dp(220)
            pos_hint: {"center_x": 0.5}

        Label:
            text: "Digital Oracle"
            font_size: '30sp'
            color: 0.8, 0.6, 1, 1  # Lavender
            bold: True
            size_hint_y: None
            pos_hint:{"top":1.0}
        
        Widget:
            size_hint_y:0.2
    
        TextInput:
            id: user_q
            hint_text: "What does the void whisper to you today?"
            multiline: False
            size_hint_y: 0.5
            background_color: 0.1, 0.1, 0.2, 1
            foreground_color: 1, 1, 1, 1
            cursor_color: 0.8, 0.6, 1, 1

        Button:
            text: "Ask Question"
            size_hint_y: None
            height: dp(40)
            background_normal: ''
            background_color: 0.4, 0.2, 0.6, 1
            on_press: root.submit(self)

<ReadingScreen>:
    canvas.before:
        Color:
            rgba: 0.05, 0.05, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10

        Label:
            id: status
            text: "Aligning cosmic energies..."
            size_hint_y: 0.1
            color: 0.7, 0.7, 0.7, 1
            italic: True

        ScrollView:
            size_hint_y: 0.8
            Label:
                id: reading_label
                text: ""
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                halign: 'center'
                valign: 'top'
                padding: [10, 10]
                font_size: '18sp'
                line_height: 1.2

        Button:
            text: "RETURN TO DUST"
            size_hint_y: None
            height: dp(40)
            background_color: 0.2, 0.2, 0.3, 1
            on_press: root.go_back(self)


<KeyScreen>:
    BoxLayout:
        orientation:"vertical"
        padding: 10
        spacing: 20
        
        TextInput:
            id:keyfield
            hint_text:"Enter Google API key here"
            multiline:False
            size_hint_x: 0.8
            size_hint_y:None
            height:self.height
        
        Label:
            halign:"center"
            text:"API Key"
        
        Button:
            text: "Save Key"
            size_hint_y: None
            height: dp(40)
            background_color: 0.2, 0.2, 0.3, 1
            on_release:root.save_key()
            